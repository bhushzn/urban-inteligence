# Frontend Production Environment Variables (Vercel / Netlify)

# Replace with your deployed backend URL on Render or Railway
# Example: https://cityeye-api.onrender.com
VITE_API_URL=https://cityeye-api.onrender.com

# WebSocket URL is auto-derived from VITE_API_URL (https -> wss).
# If custom, specify here:
# VITE_WS_URL=wss://cityeye-api.onrender.com/ws
