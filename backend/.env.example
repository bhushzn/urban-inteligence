# UrbanIntel AI — Environment Configuration

# Database Configuration
# Leave blank for local SQLite (urbanintel.db)
# Or provide PostgreSQL URI for cloud production (Render / Supabase / Neon / Railway):
# DATABASE_URL=postgresql://user:password@host:port/database_name
DATABASE_URL=

# SQLite custom path (defaults to urbanintel.db if DATABASE_URL is empty)
SQLITE_DB_PATH=urbanintel.db

# JWT Authentication Secret (Change to a random secure string in production)
JWT_SECRET=urbanintel-sih-2024-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudinary Storage Configuration (Optional)
# If provided, uploaded incident photos will be hosted on Cloudinary CDN.
# If omitted, images will be safely saved locally to ./uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Uploads Directory
UPLOADS_DIR=uploads
